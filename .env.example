# Налаштування застосунку з auth0 (лаб. 2-3)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
# Identifier API, для якого видається access token. Обов'язковий: лише тоді access token буде JWT з підписом RS256.
# Можна вказати Management API: https://your-tenant.eu.auth0.com/api/v2/
AUTH0_AUDIENCE=https://your-tenant.eu.auth0.com/api/v2/
AUTH0_CONNECTION=Username-Password-Authentication

PORT=3000
# Оновлювати access token, коли до завершення його життя лишилось менше N секунд
REFRESH_THRESHOLD_SECONDS=60
